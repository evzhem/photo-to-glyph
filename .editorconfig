root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{md,yml,yaml,json,xml}]
indent_size = 2

[*.{sh,py}]
indent_size = 4

[*.{kt,kts}]
ktlint_code_style = ktlint_official
ktlint_function_naming_ignore_when_annotated_with = Composable
max_line_length = off

[*.md]
trim_trailing_whitespace = false

# Accepted M0 modules are named after their algorithms, not their result DTOs.
[core/src/main/kotlin/photoglyph/core/{Vectorize.kt,thin/ZhangSuen.kt,graph/SkeletonToPolylines.kt}]
ktlint_standard_filename = disabled
